{
  "metadata": {
    "pipeline_id": "executive_briefing",
    "name": "Executive Intelligence Briefing",
    "description": "Personalized daily/weekly intelligence digest with prioritized updates.",
    "category": "monitoring",
    "author": "Fylorra",
    "version": "1.3",
    "created_date": "2026-01-02",
    "tags": ["briefing", "news", "monitoring"]
  },
  "global_config": {
    "example_prompt": "Topics: AI, Renewable Energy | Companies: NVIDIA, Tesla | Frequency: Daily"
  },
  "stages": [
    {
      "stage_id": "aggregation",
      "name": "Aggregation",
      "agent": "briefing_research_agent",
