        "approval_required": false,
        "skip_if_previous_failed": true
      }
    },
    {
      "stage_id": "briefing",
      "name": "Briefing",
      "agent": "briefing_writing_agent",
      "config": {
        "approval_required": false
      }
    },
    {
      "stage_id": "export",
      "name": "Export",
      "agent": "export_agent",
      "input_mapping": {
        "document": "briefing.document"
      },
      "config": {
        "approval_required": false
      }
    }
  ]
}
