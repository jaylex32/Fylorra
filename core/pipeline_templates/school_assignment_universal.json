{
  "metadata": {
    "pipeline_id": "school_assignment_universal",
    "name": "School Assignment (Any Topic)",
    "description": "General school assignment workflow for any subject. Keeps a student-friendly structure with citations and clean formatting.",
    "category": "education",
    "author": "Fylorra",
    "version": "1.1",
    "created_date": "2026-02-08",
    "tags": ["school", "assignment", "education", "research", "essay", "report"]
  },
  "global_config": {
    "example_prompt": "Create a school assignment about renewable energy for middle school students, with clear citations."
  },
  "stages": [
    {
      "stage_id": "research",
      "name": "Find Sources",
      "agent": "research_agent",
      "config": {
        "approval_required": false,
        "skip_if_previous_failed": true
      }
    },
    {
      "stage_id": "draft",
      "name": "Write Assignment",
      "agent": "school_assignment_writing_agent",
      "config": {
        "approval_required": false
      }
    },
    {
      "stage_id": "validation",
      "name": "Final Review",
      "agent": "validation_agent",
      "config": {
        "approval_required": false
      }
    },
    {
      "stage_id": "title_selection",
      "name": "Choose Title",
      "agent": "title_suggestion_agent",
      "input_mapping": {
        "document": "validation.improved_text",
        "sources": "validation.sources",
        "source_meta": "validation.source_meta"
      },
      "config": {
        "approval_required": true,
        "approval_message": "Choose the final project title (5 options) before exporting."
      }
    },
    {
      "stage_id": "export",
      "name": "Export",
      "agent": "export_agent",
      "input_mapping": {
        "document": "title_selection.document"
      },
      "config": {
        "approval_required": false
      }
    }
  ]
}
