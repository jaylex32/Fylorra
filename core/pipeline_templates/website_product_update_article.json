{
  "metadata": {
    "pipeline_id": "website_product_update_article",
    "name": "Website Product Update Article",
    "description": "Create a customer-facing product update article with clear highlights, context, and source-backed claims.",
    "category": "content",
    "author": "Fylorra",
    "version": "1.0",
    "created_date": "2026-02-08",
    "tags": ["website", "product", "update", "article", "release notes", "content"]
  },
  "global_config": {
    "example_prompt": "Write a product update article announcing new collaboration features and security improvements."
  },
  "stages": [
    {
      "stage_id": "research",
      "name": "Collect Source Material",
      "agent": "research_agent",
      "config": {
        "approval_required": false,
        "skip_if_previous_failed": true
      }
    },
    {
      "stage_id": "draft",
      "name": "Draft Update Article",
      "agent": "web_article_writing_agent",
      "config": {
        "approval_required": false
      }
    },
    {
      "stage_id": "title_selection",
      "name": "Choose Title",
      "agent": "title_suggestion_agent",
      "input_mapping": {
        "document": "draft.document",
        "sources": "draft.sources",
        "source_meta": "draft.source_meta"
      },
      "config": {
        "approval_required": true,
        "approval_message": "Choose the final update title (5 options) before exporting."
      }
    },
    {
      "stage_id": "export",
      "name": "Export",
      "agent": "export_agent",
      "input_mapping": {
        "document": "title_selection.document"
      },
      "config": {
        "approval_required": false
      }
    }
  ]
}
